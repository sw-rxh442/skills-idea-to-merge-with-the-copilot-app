---
const { title = "Mona's Bookmark Manager App" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style>
      /* Monaspace webfonts (GitHub Next, SIL OFL 1.1) self-hosted from /public/fonts.
         Neon carries body text; Xenon gives headings a touch of contrast.
         Self-hosting keeps the app fully offline-capable — no runtime CDN needed;
         the ui-monospace fallback still covers any load failure. */
      @font-face {
        font-family: 'Monaspace Neon';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('/fonts/MonaspaceNeon-400.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Neon';
        font-style: normal;
        font-weight: 600;
        font-display: swap;
        src: url('/fonts/MonaspaceNeon-600.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Neon';
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url('/fonts/MonaspaceNeon-700.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Xenon';
        font-style: normal;
        font-weight: 600;
        font-display: swap;
        src: url('/fonts/MonaspaceXenon-600.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Xenon';
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url('/fonts/MonaspaceXenon-700.woff2') format('woff2');
      }
      :root {
        color-scheme: light dark;
        --accent: #3b82f6;
        --border: #8883;
        --muted: color-mix(in srgb, currentColor 60%, transparent);
        --radius: 0.6rem;
        --font-body: 'Monaspace Neon', ui-monospace, 'SF Mono', 'Cascadia Code', monospace;
        --font-head: 'Monaspace Xenon', 'Monaspace Neon', ui-monospace, monospace;
      }
      * { box-sizing: border-box; }
      [hidden] { display: none !important; }
      body {
        font-family: var(--font-body);
        line-height: 1.5;
        max-width: 40rem;
        margin: 0 auto;
        padding: 2.5rem 1.25rem 4rem;
        min-height: 100vh;
        background:
          radial-gradient(40rem 20rem at 85% -5%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 70%),
          radial-gradient(30rem 18rem at -10% 10%, color-mix(in srgb, #a855f7 16%, transparent), transparent 70%);
        background-repeat: no-repeat;
      }
      a { color: inherit; text-decoration-color: color-mix(in srgb, var(--accent) 60%, transparent); text-underline-offset: 0.2em; }
      a:hover { color: var(--accent); }
      main {
        padding: 1.25rem;
        border: 1px solid var(--border);
        border-radius: calc(var(--radius) * 1.5);
        background: color-mix(in srgb, Canvas 78%, transparent);
        box-shadow: 0 12px 40px -18px #0006;
      }
      .error { margin: 0 0 1rem; padding: 0.5rem 0.75rem; font-size: 0.85rem; color: #b91c1c; background: #ef44441a; border: 1px solid #ef444455; border-radius: var(--radius); }
      @media (prefers-color-scheme: dark) { .error { color: #fca5a5; } }
      .bookmark .sep { color: var(--muted); white-space: pre; }
      header { margin-bottom: 1.5rem; }
      h1 { margin: 0 0 0.25rem; font-size: 1.75rem; font-family: var(--font-head); letter-spacing: -0.01em; }
      .tagline { margin: 0; color: var(--muted); }

      form {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        align-items: end;
        margin: 1.5rem 0 0.5rem;
      }
      .field { display: flex; flex-direction: column; gap: 0.35rem; flex: 1 1 16rem; }
      label { font-size: 0.85rem; font-weight: 600; }
      input {
        padding: 0.6rem 0.7rem;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        font: inherit;
        background: transparent;
        color: inherit;
      }
      input:focus-visible,
      button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      button {
        padding: 0.6rem 1rem;
        border: 1px solid transparent;
        border-radius: var(--radius);
        background: var(--accent);
        color: #fff;
        font: inherit;
        font-weight: 600;
        cursor: pointer;
      }
      button:hover { filter: brightness(1.05); }
      .hint { margin: 0 0 1.5rem; font-size: 0.8rem; color: var(--muted); }

      #list-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin: 0.5rem 0;
      }
      .list-title { margin: 0; font-size: 1rem; font-family: var(--font-head); }
      .clear {
        background: transparent;
        color: inherit;
        border: 1px solid var(--border);
        padding: 0.35rem 0.7rem;
        font-size: 0.8rem;
        font-weight: 500;
      }
      .clear:hover { border-color: currentColor; }

      ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }
      li.bookmark {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem 0.75rem;
        padding: 0.75rem 0.9rem;
        border: 1px solid var(--border);
        border-radius: var(--radius);
      }
      .bookmark .url { flex: 0 1 auto; min-width: 0; overflow-wrap: anywhere; }
      .bookmark .slug {
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 0.85rem;
        padding: 0.15rem 0.5rem;
        border-radius: 999px;
        background: color-mix(in srgb, var(--accent) 18%, transparent);
      }
      .bookmark .copy { margin-left: auto; }
      .bookmark .copy {
        background: transparent;
        color: inherit;
        border: 1px solid var(--border);
        padding: 0.3rem 0.6rem;
        font-size: 0.8rem;
        font-weight: 500;
      }
      .empty {
        margin: 0;
        padding: 1.5rem;
        text-align: center;
        color: var(--muted);
        border: 1px dashed var(--border);
        border-radius: var(--radius);
      }

      footer { margin-top: 2.5rem; font-size: 0.8rem; color: var(--muted); }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
