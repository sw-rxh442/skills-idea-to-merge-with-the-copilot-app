---
// Bookmarks component.
//
// The markup below renders during the static build. All dynamic behavior
// (adding, slug generation, localStorage persistence) runs ONLY in the
// client-side <script> at the bottom, which Astro never executes at build time.
// Pure logic lives in src/lib/bookmarks.ts so it can be unit tested.
---
<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
      aria-describedby="form-error"
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p id="form-error" class="error" role="alert" hidden></p>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  // CLIENT-SIDE BOUNDARY — runs in the browser only.
  import {
    STORAGE_KEY,
    addBookmark,
    formatBookmark,
    loadBookmarks,
    SEPARATOR,
    type Bookmark,
  } from '../lib/bookmarks';

  const form = document.getElementById('add-bookmark') as HTMLFormElement | null;
  const input = document.getElementById('url') as HTMLInputElement | null;
  const errorEl = document.getElementById('form-error');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const list = document.getElementById('bookmark-list');
  const clearAll = document.getElementById('clear-all');

  let bookmarks: Bookmark[] = [];

  function readStorage(): Bookmark[] {
    try {
      return loadBookmarks(window.localStorage.getItem(STORAGE_KEY));
    } catch {
      return [];
    }
  }

  function writeStorage(): void {
    try {
      window.localStorage.setItem(STORAGE_KEY, JSON.stringify(bookmarks));
    } catch {
      showError('Could not save to browser storage; this bookmark may be lost on reload.');
    }
  }

  function showError(message: string): void {
    if (!errorEl) return;
    errorEl.textContent = message;
    errorEl.hidden = !message;
    input?.setAttribute('aria-invalid', message ? 'true' : 'false');
  }

  async function copySlug(slug: string, button: HTMLButtonElement): Promise<void> {
    try {
      await navigator.clipboard.writeText(slug);
      button.textContent = 'Copied';
    } catch {
      button.textContent = 'Copy failed';
    }
    setTimeout(() => (button.textContent = 'Copy'), 1500);
  }

  function render(): void {
    if (!list) return;
    list.replaceChildren(
      ...bookmarks.map((bookmark) => {
        const li = document.createElement('li');
        li.className = 'bookmark';
        li.setAttribute('aria-label', formatBookmark(bookmark));

        const link = document.createElement('a');
        link.className = 'url';
        link.href = bookmark.url;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        link.textContent = bookmark.url;

        const sep = document.createElement('span');
        sep.className = 'sep';
        sep.textContent = SEPARATOR;

        const slug = document.createElement('span');
        slug.className = 'slug';
        slug.textContent = bookmark.slug;

        const copy = document.createElement('button');
        copy.type = 'button';
        copy.className = 'copy';
        copy.textContent = 'Copy';
        copy.setAttribute('aria-label', `Copy ${bookmark.slug}`);
        copy.addEventListener('click', () => void copySlug(bookmark.slug, copy));

        li.append(link, sep, slug, copy);
        return li;
      }),
    );
    const has = bookmarks.length > 0;
    if (emptyState) emptyState.hidden = has;
    if (listHeader) listHeader.hidden = !has;
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault(); // must stay first so an error can never reload the page
    try {
      const result = addBookmark(bookmarks, input?.value);
      if (!result.ok) {
        showError(result.error);
        input?.focus();
        return;
      }
      bookmarks = result.bookmarks;
      showError('');
      writeStorage();
      render();
      if (input) input.value = '';
      input?.focus();
    } catch {
      showError('Something went wrong adding that bookmark. Please try again.');
    }
  });

  input?.addEventListener('input', () => showError(''));

  clearAll?.addEventListener('click', () => {
    try {
      if (!window.confirm('Remove all saved bookmarks?')) return;
      bookmarks = [];
      try {
        window.localStorage.removeItem(STORAGE_KEY);
      } catch {
        // storage unavailable; the in-memory list is already cleared
      }
      render();
    } catch {
      showError('Could not clear bookmarks.');
    }
  });

  try {
    bookmarks = readStorage();
    // Re-save so dropped or migrated entries are cleaned out of storage.
    if (bookmarks.length) writeStorage();
    render();
  } catch {
    bookmarks = [];
    render();
  }
</script>
